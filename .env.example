# Copy this file to .env.local and fill in your real values.

# MongoDB Atlas connection string (Atlas → Clusters → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/e_elections?retryWrites=true&w=majority

# Random string, at least 32 characters (signs login/ballot session cookies)
SESSION_SECRET=change-me-to-a-long-random-string

# --- Recommended for production (each 32+ random characters) --------------
# Key for the HMAC seals on every ballot. Never store it in the database.
# If unset, a key is derived from SESSION_SECRET.
LEDGER_SECRET=
# AES-256-GCM key that encrypts face templates and photos at rest.
# If unset, a key is derived from SESSION_SECRET.
# WARNING: changing either key later makes existing seals / faces unreadable.
BIOMETRIC_KEY=

# Public address of the site, e.g. https://e-elections.example.ke
# Pins the fingerprint (WebAuthn) origin instead of trusting the Host header.
APP_ORIGIN=

# Optional: first admin account created by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Optional: AWS Rekognition face scanning --------------------------------
# Set to "aws" to scan and match faces with AWS (liveness + 1:N search)
# instead of the built-in browser engine. Voters keep the engine they were
# registered with; anyone on the other engine can still use Fingerprint.
NEXT_PUBLIC_FACE_PROVIDER=
# An IAM user's keys. Its policy needs: rekognition:CreateFaceLivenessSession,
# GetFaceLivenessSessionResults, StartFaceLivenessSession, CreateCollection,
# SearchFacesByImage, IndexFaces, DeleteFaces, and sts:GetFederationToken.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# A region with Face Liveness, e.g. us-east-1, eu-west-1 or eu-central-1.
AWS_REGION=us-east-1
AWS_REKOGNITION_COLLECTION=e-elections-voters

# --- Server face engine (src/lib/faceEngine.ts) ------------------------------
# Models are downloaded by: npx tsx scripts/fetch-face-models.ts (into ml-models/)
# FACE_MODEL_DIR=            # a different folder for the models
# FACE_GPU=off               # Windows: don't use the GPU (DirectML) for face recognition
# FACE_ANTISPOOF=enforce     # block scans the anti-spoof model flags (calibrate on real cameras first)
# FACE_FLIP=off             # read each face once instead of as-is + mirrored (a little faster, slightly less accurate)
